# Build stage
FROM node:22-alpine AS builder

WORKDIR /app

# Install build dependencies for sharp
RUN apk add --no-cache libc6-compat build-base vips-dev

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/pnpm-lock.yaml* ./backend/
COPY frontend/package.json frontend/pnpm-lock.yaml* ./frontend/

# Install dependencies
RUN corepack enable pnpm &&     pnpm install --frozen-lockfile --prod=false --ignore-scripts

# Copy source code
COPY . .

# Build application
RUN cd frontend && pnpm install --frozen-lockfile && pnpm run build

# Production stage
FROM node:22-alpine AS runner

WORKDIR /app

# Install production dependencies for sharp
RUN apk add --no-cache libc6-compat vips

# Create non-root user
RUN addgroup --system --gid 1001 nodejs &&     adduser --system --uid 1001 kevasiya

# Set environment
ENV NODE_ENV=production     PORT=5001     PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true     NEXT_SHARP_PATH=/app/node_modules/sharp

# Copy built files
COPY --from=builder --chown=kevasiya:nodejs /app/frontend/.next/standalone ./
COPY --from=builder --chown=kevasiya:nodejs /app/frontend/.next/static ./frontend/.next/static
COPY --from=builder --chown=kevasiya:nodejs /app/frontend/public ./frontend/public

# Mirror to root for compatibility
COPY --from=builder --chown=kevasiya:nodejs /app/frontend/.next/static ./.next/static
COPY --from=builder --chown=kevasiya:nodejs /app/frontend/public ./public

# Clean up broken sharp and install clean sharp
RUN rm -rf /app/node_modules/sharp /app/frontend/node_modules/sharp &&     npm install sharp &&     mkdir -p /app/frontend/node_modules &&     ln -s /app/node_modules/sharp /app/frontend/node_modules/sharp

COPY --from=builder --chown=kevasiya:nodejs /app/package.json ./
COPY --from=builder --chown=kevasiya:nodejs /app/backend ./backend

# Create uploads directory
RUN mkdir -p /app/backend/uploads /app/backend/temp_uploads &&     chown -R kevasiya:nodejs /app

# Switch to non-root user
USER kevasiya

# Expose port
EXPOSE 5001

# Start application
CMD ["node", "backend/server.js"]
