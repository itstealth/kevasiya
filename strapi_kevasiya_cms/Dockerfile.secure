FROM node:20-slim
WORKDIR /app
RUN apt-get update && apt-get install -y libvips-dev build-essential gcc autoconf automake zlib1g-dev libpng-dev > /dev/null 2>&1 && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json* ./
RUN npm install --legacy-peer-deps
COPY . .
ENV NODE_ENV=production STRAPI_TELEMETRY_DISABLED=true PORT=1337
RUN npm run build 2>&1 | tee build.log || (cat build.log && exit 1)
RUN addgroup --system --gid 1001 strapi &&     adduser --system --uid 1001 strapi --no-create-home --home /app
RUN mkdir -p /app/public/uploads && chown -R strapi:strapi /app
USER strapi
EXPOSE 1337
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5     CMD node -e "require('http').request('http://localhost:1337/_health', (r) => {if(r.statusCode !== 200) process.exit(1)}).on('error', () => process.exit(1)).end()" || exit 1
CMD ["npm", "run", "start"]
